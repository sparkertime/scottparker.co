---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ReviewCard from '../../components/review/ReviewCard.astro';
import ReviewFilters from '../../components/review/ReviewFilters.astro';
import StarRating from '../../components/review/StarRating.astro';
import { cleanSlug } from '../../utils/slugify';
import { formatDate } from '../../utils/date';

const reviews = (await getCollection('reviews', r => !r.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const types = [...new Set(reviews.map(r => r.data.type))].sort();
const years = [...new Set(reviews.map(r => r.data.date.getUTCFullYear()))].sort((a, b) => b - a);

const TYPE_LABELS: Record<string, string> = { boardgame: 'Board Game', tv: 'TV' };

const rendered = await Promise.all(
  reviews.map(async r => ({
    review: r,
    url: `/reviews/${cleanSlug(r.slug)}/`,
    Content: (await r.render()).Content,
  }))
);
---
<BaseLayout title="Reviews">
  <div class="max-w-3xl mx-auto pt-14 p-4">
    <div class="flex items-baseline justify-between mb-2">
      <h1 class="text-4xl font-bold font-sans">Reviews</h1>
      <div class="flex items-center gap-4">
        <div class="flex gap-1 font-sans text-sm" id="view-toggle">
          <button id="btn-text" class="px-2 py-1 rounded font-medium transition-colors bg-fuchsia-600 text-white">Text</button>
          <button id="btn-grid" class="px-2 py-1 rounded font-medium transition-colors text-slate-500 hover:text-fuchsia-600">Grid</button>
        </div>
        <a href="/reviews/list/" class="font-sans text-sm text-fuchsia-600 hover:text-fuchsia-800 underline">
          List view
        </a>
      </div>
    </div>
    <p class="text-slate-500 font-sans mb-8">
      Movies, books, games, and more — rated 1–5 stars.
    </p>

    {reviews.length > 0 ? (
      <>
        <ReviewFilters types={types} years={years} />

        <div id="view-text">
          {rendered.map(({ review, url, Content }, i) => (
            <div
              data-review
              data-review-type={review.data.type}
              data-review-rating={String(review.data.rating)}
              data-review-year={String(review.data.date.getUTCFullYear())}
            >
              <article class="py-6">
                <div class="flex gap-5 items-start">
                  <div class="grow min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-1 font-sans text-sm text-slate-500">
                      <span class="capitalize">{TYPE_LABELS[review.data.type] ?? review.data.type}</span>
                      <span aria-hidden="true">·</span>
                      <StarRating rating={review.data.rating} />
                      <span aria-hidden="true">·</span>
                      <span>{formatDate(review.data.date)}</span>
                    </div>
                    <h2 class="text-2xl font-bold font-sans mb-1">
                      <a class="hover:underline" href={url}>{review.data.title}</a>
                    </h2>
                    {review.data.description && (
                      <p class="text-slate-500 font-sans text-sm mb-3">{review.data.description}</p>
                    )}
                    {review.data.externalUrl && (
                      <a
                        href={review.data.externalUrl}
                        class="font-sans text-sm text-fuchsia-600 hover:text-fuchsia-800 underline mb-3 inline-block"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {review.data.type === 'book' ? 'View on Goodreads' : 'View on Letterboxd'} →
                      </a>
                    )}
                    <div class="prose max-w-none">
                      <Content />
                    </div>
                  </div>
                  {review.data.headerImage && (
                    <img
                      src={review.data.headerImage}
                      alt={review.data.title}
                      class="hidden sm:block w-28 shrink-0 rounded"
                      loading="lazy"
                    />
                  )}
                </div>
              </article>
              {i < rendered.length - 1 && <hr class="border-slate-200" />}
            </div>
          ))}
        </div>

        <div id="view-grid" style="display:none" class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {reviews.map(review => (
            <div
              data-review
              data-review-type={review.data.type}
              data-review-rating={String(review.data.rating)}
              data-review-year={String(review.data.date.getUTCFullYear())}
            >
              <ReviewCard review={review} />
            </div>
          ))}
        </div>

        <p id="reviews-empty" class="text-slate-500 font-sans text-center py-12" style="display:none">
          No reviews match your filters.
        </p>
      </>
    ) : (
      <p class="text-slate-500 font-sans">No reviews yet. Check back soon!</p>
    )}
  </div>
</BaseLayout>

<script>
  const btnText = document.getElementById('btn-text') as HTMLButtonElement;
  const btnGrid = document.getElementById('btn-grid') as HTMLButtonElement;
  const viewText = document.getElementById('view-text') as HTMLElement;
  const viewGrid = document.getElementById('view-grid') as HTMLElement;

  const activeClass   = 'px-2 py-1 rounded font-medium transition-colors bg-fuchsia-600 text-white';
  const inactiveClass = 'px-2 py-1 rounded font-medium transition-colors text-slate-500 hover:text-fuchsia-600';

  function setView(mode: 'text' | 'grid', updateUrl = true) {
    const isGrid = mode === 'grid';
    viewText.style.display = isGrid ? 'none' : '';
    viewGrid.style.display = isGrid ? '' : 'none';
    btnText.className = isGrid ? inactiveClass : activeClass;
    btnGrid.className = isGrid ? activeClass : inactiveClass;

    if (updateUrl) {
      const params = new URLSearchParams(location.search);
      if (isGrid) { params.set('view', 'grid'); } else { params.delete('view'); }
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
  }

  btnText.addEventListener('click', () => setView('text'));
  btnGrid.addEventListener('click', () => setView('grid'));

  // Restore view from URL on load (runs after ReviewFilters script loads)
  const initView = new URLSearchParams(location.search).get('view');
  if (initView === 'grid') setView('grid', false);
</script>
