---
import BaseLayout from '../components/layout/BaseLayout.astro';
---
<BaseLayout title="Page Not Found">
  <div class="max-w-3xl mx-auto pt-14 p-4 text-center">
    <h1 class="text-6xl font-bold font-sans text-slate-300 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-8">Page not found.</p>
    <a href="/" class="font-sans text-fuchsia-600 hover:text-fuchsia-800 underline">
      ← Back to the blog
    </a>
  </div>
</BaseLayout>
