---
interface Props {
  types: string[];
  years: number[];
}

const { types, years } = Astro.props;

const TYPE_LABELS: Record<string, string> = {
  boardgame: 'Board Game',
  tv: 'TV',
};
---
<div class="flex flex-wrap gap-4 font-sans mb-8 p-4 bg-white rounded-lg border border-slate-200">
  <div class="flex flex-col gap-1">
    <label for="filter-type" class="text-xs font-medium text-slate-500 uppercase tracking-wide">Type</label>
    <select id="filter-type" class="text-sm border border-slate-300 rounded px-2 py-1 bg-white">
      <option value="">Everything</option>
      {types.map(t => (
        <option value={t}>{TYPE_LABELS[t] ?? (t.charAt(0).toUpperCase() + t.slice(1))}</option>
      ))}
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="filter-rating" class="text-xs font-medium text-slate-500 uppercase tracking-wide">Rating</label>
    <select id="filter-rating" class="text-sm border border-slate-300 rounded px-2 py-1 bg-white">
      <option value="">All ratings</option>
      <option value="5">★★★★★</option>
      <option value="4">★★★★☆</option>
      <option value="3">★★★☆☆</option>
      <option value="2">★★☆☆☆</option>
      <option value="1">★☆☆☆☆</option>
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="filter-year" class="text-xs font-medium text-slate-500 uppercase tracking-wide">Year</label>
    <select id="filter-year" class="text-sm border border-slate-300 rounded px-2 py-1 bg-white">
      <option value="">All years</option>
      {years.map(y => (
        <option value={String(y)}>{y}</option>
      ))}
    </select>
  </div>

  <div class="flex items-end">
    <button
      id="filter-reset"
      class="text-sm text-slate-500 hover:text-fuchsia-600 underline transition-colors"
    >
      Reset
    </button>
  </div>
</div>

<script>
  const selType   = document.getElementById('filter-type')   as HTMLSelectElement;
  const selRating = document.getElementById('filter-rating') as HTMLSelectElement;
  const selYear   = document.getElementById('filter-year')   as HTMLSelectElement;

  function applyFilters() {
    const type   = selType.value;
    const rating = selRating.value;
    const year   = selYear.value;

    document.querySelectorAll<HTMLElement>('[data-review]').forEach(el => {
      const matchType   = !type   || el.dataset.reviewType   === type;
      const matchRating = !rating || el.dataset.reviewRating === rating;
      const matchYear   = !year   || el.dataset.reviewYear   === year;
      el.style.display  = matchType && matchRating && matchYear ? '' : 'none';
    });

    const visible = document.querySelectorAll<HTMLElement>('[data-review]:not([style*="none"])').length;
    const empty = document.getElementById('reviews-empty');
    if (empty) empty.style.display = visible === 0 ? '' : 'none';

    // Sync URL params so the link is shareable and back-button restores state
    const params = new URLSearchParams();
    if (type)   params.set('type',   type);
    if (rating) params.set('rating', rating);
    if (year)   params.set('year',   year);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function loadFromURL() {
    const params = new URLSearchParams(location.search);
    selType.value   = params.get('type')   ?? '';
    selRating.value = params.get('rating') ?? '';
    selYear.value   = params.get('year')   ?? '';
    applyFilters();
  }

  selType.addEventListener('change',   applyFilters);
  selRating.addEventListener('change', applyFilters);
  selYear.addEventListener('change',   applyFilters);

  document.getElementById('filter-reset')?.addEventListener('click', () => {
    selType.value = selRating.value = selYear.value = '';
    applyFilters();
  });

  // Restore filters on load (handles back-button and shared links)
  loadFromURL();
</script>
